# Public HTTPS address reachable from every managed node. No trailing slash.
PANEL_URL=https://panel.example.com
# Listen on loopback; put an HTTPS reverse proxy in front of the panel.
PANEL_BIND=127.0.0.1
PANEL_PORT=18899
TZ=Asia/Shanghai
# Optional: only used when the persistent data directory is first initialized.
ADMIN_USER=admin
# Empty means generate a random password. Read it from data/credentials.txt locally.
ADMIN_PASSWORD=
# Optional direct origin IP for legacy Reality bootstrap callbacks; normal Argo agents use PANEL_URL.
ORIGIN_IP=
