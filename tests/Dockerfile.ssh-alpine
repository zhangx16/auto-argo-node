FROM alpine:3.22
RUN apk add --no-cache openssh-server openssh-sftp-server bash curl jq util-linux-misc dcron && mkdir -p /run/sshd && ssh-keygen -A
RUN printf '%s\n' 'PermitRootLogin yes' 'PasswordAuthentication yes' 'KbdInteractiveAuthentication no' 'PidFile /run/sshd-test.pid' 'Subsystem sftp internal-sftp' > /etc/ssh/sshd_config
CMD ["/usr/sbin/sshd","-D","-e"]
